# Base de données
MONGO_URL=mongodb://localhost:27017/hubertapp_notifications

# RabbitMQ
RABBITMQ_URL=amqp://user:password@localhost:5672

# Canal e-mail (SmtpMailProvider) — optionnel : si SMTP_HOST est absent, les
# e-mails sont simplement logués au lieu d'être envoyés (voir smtp-mail.provider.ts).
# Fonctionne avec n'importe quel serveur SMTP standard.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
# Certains relais (Gmail notamment) n'acceptent comme expéditeur que le compte
# authentifié ou un alias vérifié : dans ce cas SMTP_FROM doit valoir SMTP_USER,
# sinon l'envoi est rejeté (553-5.7.508) ou l'expéditeur réécrit.
SMTP_FROM=no-reply@hubertapp.local

# Destinataire des notifications d'exploitation (résultat d'agrégation d'un
# réseau de transport, émis par MS-Admin sur l'event
# `transit_network_aggregated`). Si ADMIN_NOTIFICATION_EMAIL est vide,
# l'événement est logué puis ignoré : aucun mail ne part.
# ADMIN_USER_ID n'est qu'une clé de persistance de la notification en base, il
# ne correspond à aucun compte MS-User — c'est ADMIN_NOTIFICATION_EMAIL qui
# détermine réellement le destinataire.
ADMIN_NOTIFICATION_EMAIL=
ADMIN_USER_ID=admin

# URL interne de MS-User, utilisée par UserLookupService pour résoudre
# l'e-mail d'un utilisateur (jamais fourni par le client, voir
# user-lookup.service.ts).
MS_USER_URL=http://service-user:3001/graphql

# URL publique du front, utilisée pour construire les liens dans les e-mails
# (bouton "Ouvrir HubertApp", lien de désabonnement). Voir
# channels/email-notification.channel.ts.
FRONT_PUBLIC_URL=http://localhost:8080

NODE_ENV=development
