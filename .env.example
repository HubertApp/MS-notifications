# Base de données
MONGO_URL=mongodb://localhost:27017/hubertapp_notifications

# RabbitMQ
RABBITMQ_URL=amqp://user:password@localhost:5672

# Canal e-mail (SmtpMailProvider) — optionnel : si SMTP_HOST est absent, les
# e-mails sont simplement logués au lieu d'être envoyés (voir smtp-mail.provider.ts).
# Fonctionne avec n'importe quel serveur SMTP standard.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@hubertapp.local

# URL interne de MS-User, utilisée par UserLookupService pour résoudre
# l'e-mail d'un utilisateur (jamais fourni par le client, voir
# user-lookup.service.ts).
MS_USER_URL=http://service-user:3001/graphql

# URL publique du front, utilisée pour construire les liens dans les e-mails
# (bouton "Ouvrir HubertApp", lien de désabonnement). Voir
# channels/email-notification.channel.ts.
FRONT_PUBLIC_URL=http://localhost:8080

NODE_ENV=development
